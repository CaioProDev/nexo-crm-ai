# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Temporary access gate for this private MVP. Use a long, unique password.
CRM_BASIC_AUTH_USER=nexo-admin
CRM_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

OPENAI_API_KEY=your-openai-api-key

# Optional: defaults to a cost-conscious model suitable for structured analysis.
OPENAI_MODEL=gpt-5.6-luna
